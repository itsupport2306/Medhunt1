# Current local database. DATABASE_URL is ignored while this is sqlite.
DATABASE_BACKEND=sqlite
DATABASE_URL=
DATABASE_NAME=
# PostgreSQL namespace used to avoid collisions with Nexus or other apps.
MEDHUNT_DATABASE_SCHEMA=medhunt
DATABASE_CONNECT_TIMEOUT=10
# Generated per workstation by Medhunt Setup; do not share between installs.
MEDHUNT_LOCAL_API_TOKEN=

# HealthBoard owns public Medhunt accounts and email-code login.
# Local development normally uses http://127.0.0.1:8000; production must use HTTPS.
HEALTHBOARD_BASE_URL=
HEALTHBOARD_AUTH_TIMEOUT=8
HEALTHBOARD_AUTH_CACHE_SECONDS=60
MEDHUNT_EXTENSION_ORIGINS=
# Local development only. Hosted Render deployments default to rejecting
# extension origins until MEDHUNT_EXTENSION_ORIGINS contains the production ID.
MEDHUNT_ALLOW_UNLISTED_EXTENSION_ORIGINS=0

# Optional local SQLite fallback when DATABASE_URL is not set.
SOURCING_DB=sourcing.db
RESUME_DOWNLOAD_DIR=C:\Users\your-user\Downloads
RESUME_MAX_BYTES=15728640
# Local OCR is used only on scanned/image-only PDF pages. The team installer
# bundles the OCR runtime, so these defaults normally need no changes.
RESUME_OCR_ENABLED=1
RESUME_OCR_LANGUAGE=eng
RESUME_OCR_MAX_PAGES=20
RESUME_OCR_MIN_PAGE_CHARS=60
RESUME_OCR_DPI=200
RESUME_OCR_PAGE_TIMEOUT=20
RESUME_OCR_TOTAL_TIMEOUT=35
RESUME_OCR_ACCEPT_CONFIDENCE=0.84
RESUME_OCR_ROLE_CONFIDENCE=0.80

# Enformion / Endato enrichment. Connected Wireless/Mobile/Cellular numbers
# are preferred; a policy-approved other phone may be used when no mobile is
# available.
ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=
ENFORMION_URL=https://devapi.enformion.com/PersonSearch
ENFORMION_SEARCH_TYPE=Person
ENFORMION_DEMO=1
ENFORMION_ENABLED=1
ENFORMION_VERIFY_PDL=1
ENFORMION_FALLBACK_ONLY=1
ENFORMION_CACHE_TTL_SECONDS=7776000
ENFORMION_MAX_WORKERS=1
# Bounded HTTP-429 recovery. Retry-After is honored up to the maximum wait;
# explicit process settings override both .env files.
ENFORMION_RATE_LIMIT_RETRIES=2
ENFORMION_RATE_LIMIT_BACKOFF_SECONDS=1.0
ENFORMION_RATE_LIMIT_MAX_WAIT_SECONDS=30.0
# Hard per-run ceiling for fresh paid Person Search calls. 0 disables fresh
# Enformion calls; valid cached results are still reused at zero cost.
ENFORMION_RUN_CREDIT_LIMIT=100

# People Data Labs enrichment. Requests require at least one usable contact
# field. Mobile is preferred; policy-approved associated phones can be used as
# a fallback, while historical/unsafe values remain audit evidence.
# Likelihood, matched-input evidence, address history, aliases, and Person Base
# job context stay backend-only; lookup results are cached for 30 days.
PDL_API_KEY=
PDL_ENABLED=1
PDL_IDENTIFY_URL=https://api.peopledatalabs.com/v5/person/identify
PDL_SEARCH_URL=https://api.peopledatalabs.com/v5/person/search
# 0 means no application-level per-lookup cap. PDL account billing still applies.
PDL_RUN_CREDIT_LIMIT=0
PDL_MIN_LIKELIHOOD=2
PDL_AUTO_ACCEPT_MIN_LIKELIHOOD=6
PDL_PROFILE_ACCEPT_MIN_LIKELIHOOD=4
# Retry true no-results and locally rejected provider people with progressively
# independent identity anchors. Every returned person still passes the same
# identity/contact gate; attempts are backend-only and capped at five.
# Deprecated compatibility flags. Medhunt sends one combined PDL request.
PDL_STAGED_RETRY_ENABLED=0
PDL_STAGED_RETRY_MAX=1
PDL_TIMEOUT=20
PDL_CACHE_TTL_SECONDS=2592000
# A selection is resolved with bulk person-enrich calls of up to 100 identities
# each, so uncapped selections are still split into provider-supported chunks.
PDL_BULK_MAX=100
PDL_BULK_TIMEOUT=90

# Identity resolution. Provider trust cannot bypass these gates.
IDENTITY_RESOLUTION_ENABLED=1
IDENTITY_MATCH_THRESHOLD=0.78
IDENTITY_REVIEW_THRESHOLD=0.62
IDENTITY_AMBIGUITY_MARGIN=0.08
CONTACT_FRESHNESS_SECONDS=7776000
NPI_ENABLED=1
NPI_BASE_URL=https://npiregistry.cms.hhs.gov/api/
NPI_TIMEOUT=12

# Optional Gemini outreach generation. AI never approves an identity match.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MATCH_ENABLED=0

# Optional server-side contact verification (may use provider credits).
VERIFY_EMAILS=0
NEVERBOUNCE_API_KEY=
VERIFY_PHONES=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
DEFAULT_PHONE_COUNTRY=US

# Optional SendGrid alerts for new/updated resumes found after the watcher's
# initial baseline. Recipients are a comma-separated administrator-owned list.
WATCHER_EMAIL_NOTIFICATIONS_ENABLED=0
WATCHER_NOTIFICATION_EMAILS=
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Medhunt
SENDGRID_TIMEOUT=15

# Optional private Cloudflare R2 storage for matched candidate resumes.
STORAGE_ENABLED=false
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# --- Quick Sourcer external contact lookup (Hub backend) ---
# One shared key, set on the Hub as QUICK_SOURCER_EXTERNAL_API_KEY.
# An uncached search runs a real browser and takes 30-90 seconds.
QUICK_SOURCER_BASE_URL=https://radixsol.net/api/quick-sourcer/external
QUICK_SOURCER_API_KEY=
QUICK_SOURCER_ENABLED=1
QUICK_SOURCER_TIMEOUT=150
QUICK_SOURCER_CACHE_TTL_SECONDS=2592000
# Set only when the administrator has approved the configured feed for
# persistence and private downstream delivery. DNC filtering still applies.
QUICK_SOURCER_TRUSTED_FOR_SYNC=0
# Optional LaborEdge Nexus delivery. The backend queues each saved resume and
# sends it with the already trusted candidate contact; the extension never
# receives these credentials. Keep disabled until tenant routing is complete.
NEXUS_SYNC_ENABLED=0
# Development-only alternative to duplicating Nexus credentials here. The
# Python file is syntax-parsed and only its NEXUS_TOKEN_BASIC literal is read.
NEXUS_REFERENCE_ENV=
NEXUS_REFERENCE_CONFIG=
NEXUS_BASE_URL=https://api-nexus.laboredge.com
NEXUS_AUTH_METHOD=password
NEXUS_TOKEN_URL=
NEXUS_TOKEN_PAYLOAD_STYLE=form
NEXUS_CLIENT_ID=
NEXUS_CLIENT_SECRET=
NEXUS_USERNAME=
NEXUS_PASSWORD=
NEXUS_STATIC_TOKEN=
NEXUS_TOKEN_BASIC=
NEXUS_ORG_CODE=
NEXUS_RESUME_DOC_TYPE_ID=
NEXUS_TIMEOUT=30
NEXUS_CONNECT_TIMEOUT=15
NEXUS_MASTER_CACHE_SECONDS=600
NEXUS_MAX_RESUME_BYTES=10485760
NEXUS_WORKER_INTERVAL_SECONDS=2
NEXUS_MAX_ATTEMPTS=8
# Must cover both duplicate searches, master-data resolution, and one upload.
NEXUS_LEASE_SECONDS=600
# Must include tenant routing such as referralSourceId and jobTypeIds. It may
# include jobId or fallback profession/specialty IDs. A specialty explicitly
# captured from the source profile overrides the generic fallback and is
# resolved exactly against Nexus master data. State can also be resolved there.
NEXUS_DEFAULT_PROFILE={}
