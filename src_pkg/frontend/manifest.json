{
  "manifest_version": 3,
  "name": "Medhunt",
  "description": "Capture authorized candidate profiles, find verified contact details, and manage recruiting workflows.",
  "version": "3.22.15",
  "icons": {
    "16": "icons/medhunt-16.png",
    "32": "icons/medhunt-32.png",
    "48": "icons/medhunt-48.png",
    "128": "icons/medhunt-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "debugger",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.indeed.com/*",
    "*://*.vivian.com/*",
    "*://*.ziprecruiter.com/*",
    "*://*.linkedin.com/*",
    "*://*.facebook.com/*",
    "*://facebook.com/*",
    "*://npino.com/*",
    "*://*.npino.com/*",
    "https://eservices.nysed.gov/*",
    "*://npiprofile.com/*",
    "*://*.npiprofile.com/*",
    "https://health.usnews.com/doctors/*",
    "https://health.usnews.com/nurse-practitioners/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Medhunt",
    "default_icon": {
      "16": "icons/medhunt-16.png",
      "32": "icons/medhunt-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.indeed.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.indeed.com/*"
      ],
      "js": [
        "indeed-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.ziprecruiter.com/*"
      ],
      "js": [
        "platform-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.vivian.com/*",
        "*://*.ziprecruiter.com/*"
      ],
      "js": [
        "platform-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/in/*",
        "*://*.linkedin.com/search/results/people/*",
        "*://*.linkedin.com/search/results/people*",
        "*://*.linkedin.com/search/results/all*"
      ],
      "js": [
        "linkedin-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://facebook.com/*"
      ],
      "js": [
        "facebook-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://npino.com/*",
        "*://*.npino.com/*",
        "https://eservices.nysed.gov/*",
        "*://npiprofile.com/*",
        "*://*.npiprofile.com/*",
        "https://health.usnews.com/doctors/*",
        "https://health.usnews.com/nurse-practitioners/*"
      ],
      "js": [
        "healthcare-directory-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
